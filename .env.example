# LLM provider: fake | openai | azure_openai | ollama
# `fake` runs fully offline (placeholder extraction, hashed embeddings).
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini            # Azure: the deployment name
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3                # SDK-level retries on 429/5xx/timeouts
# Embeddings default to LLM_PROVIDER; set to mix providers (e.g. Ollama chat + OpenAI embeddings).
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=text-embedding-3-small
# The schema stores 1536-d vectors; other sizes need a migration.
EMBEDDING_DIM=1536

OPENAI_API_KEY=

# Azure OpenAI (if LLM_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=

# Ollama (if LLM_PROVIDER=ollama); uses its OpenAI-compatible /v1 API
OLLAMA_BASE_URL=http://localhost:11434

# Local development (`make dev`). docker compose overrides these with in-network hosts.
DATABASE_URL=postgresql+asyncpg://voc:voc@localhost:5432/voc
REDIS_URL=redis://localhost:6379/0
API_KEY=change-me

# Ingestion
CHUNK_MAX_WORDS=160
CHUNK_OVERLAP_TURNS=1
EMBEDDING_BATCH_SIZE=64
INGESTION_MAX_TRIES=4
LOG_JSON=false
