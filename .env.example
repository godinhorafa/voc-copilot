# LLM provider: fake | openai | azure_openai | ollama
# `fake` runs fully offline (placeholder extraction, hashed embeddings).
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini            # Azure: the deployment name
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3                # SDK-level retries on 429/5xx/timeouts
# Embeddings default to LLM_PROVIDER; set to mix providers (e.g. Ollama chat + OpenAI embeddings).
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=text-embedding-3-small
# The schema stores 1536-d vectors; other sizes need a migration.
EMBEDDING_DIM=1536

OPENAI_API_KEY=

# Azure OpenAI (if LLM_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=

# Ollama (if LLM_PROVIDER=ollama); uses its OpenAI-compatible /v1 API
OLLAMA_BASE_URL=http://localhost:11434

# Local development (`make dev`). docker compose overrides these with in-network hosts.
DATABASE_URL=postgresql+asyncpg://voc:voc@localhost:5432/voc
REDIS_URL=redis://localhost:6379/0
API_KEY=change-me

# User sign-in (ADR 0013): accept ID tokens from this OpenID provider, sent by
# oauth2-proxy in front of the web UI. `make up-sso` sets these for local Dex.
OIDC_ISSUER=
OIDC_AUDIENCE=                    # the client id registered with the provider
OIDC_JWKS_URL=                    # optional; defaults to the issuer's discovery document
OIDC_EMAIL_CLAIM=email            # Entra ID without the email optional claim: preferred_username

# Retrieval: vector | keyword | hybrid (see ADR 0003); rerank adds one LLM call per question
RETRIEVAL_STRATEGY=hybrid
RETRIEVAL_RERANK=false
RETRIEVAL_CANDIDATES=30

# Observability: traces go to any OTLP endpoint. Local Jaeger (compose profile
# "observability"): http://jaeger:4318 from containers, http://localhost:4318 from the host.
# Langfuse and other hosted backends also need OTEL_EXPORTER_OTLP_HEADERS.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=voc-copilot
# USD per 1M tokens; defaults to app/observability/prices.yaml (verify those prices)
PRICES_FILE=

# Privacy and abuse protection
PII_REDACTION=true                # redact emails, phones, cards, IBAN, CPF/SSN, IPs at ingestion
RATE_LIMIT_ASK=20/minute          # per client (API key + IP); empty or 0 disables
RATE_LIMIT_METRICS=30/minute
RATE_LIMIT_INGEST=120/minute
RATE_LIMIT_TRUST_FORWARDED_FOR=false   # true behind a proxy that sets X-Forwarded-For

# Agent
AGENT_MAX_STEPS=6
JUDGE_MODEL=gpt-4o                # evals only: LLM-as-judge, ideally not LLM_MODEL

# Text-to-SQL. Production: a login user that is only a member of voc_analytics
# (see docs/adr/0007-guarded-text-to-sql.md); empty = switch role on the main connection.
ANALYTICS_DATABASE_URL=
SQL_MAX_ROWS=200
SQL_TIMEOUT_MS=5000

# Ingestion
CHUNK_MAX_WORDS=160
CHUNK_OVERLAP_TURNS=1
EMBEDDING_BATCH_SIZE=64
INGESTION_MAX_TRIES=4
LOG_JSON=false
