# Rendered by the nginx image at startup (envsubst on ${API_KEY} / ${API_UPSTREAM}).
# An empty API_KEY sends no key: behind oauth2-proxy, requests carry the
# signed-in user's `Authorization` header instead, which nginx passes through.
server {
    listen 8080;
    root /usr/share/nginx/html;

    # Same-origin API: the browser never sees the key; nginx adds it.
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_set_header X-API-Key "${API_KEY}";
        # Host stays the upstream's (nginx's default): Azure Container Apps routes
        # internal traffic by Host, so forwarding the browser's would miss the API.
        # The API rate-limits per client; tell it who the client is.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        # Server-sent events from /v1/ask?stream=true must not be buffered.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
