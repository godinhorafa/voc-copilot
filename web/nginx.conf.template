# Rendered by the nginx image at startup (envsubst on ${API_KEY} / ${API_UPSTREAM}).
server {
    listen 8080;
    root /usr/share/nginx/html;

    # Same-origin API: the browser never sees the key; nginx adds it.
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_set_header X-API-Key "${API_KEY}";
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        # Server-sent events from /v1/ask?stream=true must not be buffered.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
